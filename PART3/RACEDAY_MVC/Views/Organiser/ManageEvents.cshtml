@model List<RaceDay.Web.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-controller="Organiser"
               asp-action="Dashboard"
               class="btn btn-outline-secondary mb-3">
                Back to Dashboard
            </a>

            <h1 class="fw-bold">Manage Events</h1>
            <p class="text-muted">View and manage the events you have created.</p>
        </div>

        <a asp-controller="Organiser"
           asp-action="CreateEvent"
           class="btn btn-primary">
            Create New Event
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <h5>No events found</h5>
                <p class="text-muted">
                    You have not created any events yet.
                </p>

                <a asp-controller="Organiser"
                   asp-action="CreateEvent"
                   class="btn btn-primary">
                    Create Your First Event
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var raceEvent in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm">

                        @if (!string.IsNullOrEmpty(raceEvent.BannerImageUrl))
                        {
                            <img src="@raceEvent.BannerImageUrl"
                                 class="card-img-top"
                                 alt="@raceEvent.EventName"
                                 style="height: 180px; object-fit: cover;" />
                        }

                        <div class="card-body">
                            <h5 class="card-title fw-bold">
                                @raceEvent.EventName
                            </h5>

                            <p class="text-muted">
                                @raceEvent.EventDescription
                            </p>

                            <p class="mb-1">
                                <strong>Date:</strong>
                                @raceEvent.EventDate.ToString("dd MMM yyyy")
                            </p>

                            <p class="mb-1">
                                <strong>Location:</strong>
                                @raceEvent.EventLocation
                            </p>

                            <p class="mb-1">
                                <strong>Distance:</strong>
                                @raceEvent.EventDistance
                            </p>

                            <p class="mb-3">
                                <strong>Type:</strong>
                                @raceEvent.EventType
                            </p>

                            <span class="badge bg-primary">
                                Event #@raceEvent.EventId
                            </span>

                            <div class="mt-3">
                                <a asp-controller="Organiser"
                                   asp-action="EditEvent"
                                   asp-route-id="@raceEvent.EventId"
                                   class="btn btn-outline-primary">
                                    Edit Event
                                </a>
                            </div>

                            <form asp-controller="Organiser"
                                  asp-action="DeleteEvent"
                                  asp-route-id="@raceEvent.EventId"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this event?');">

                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn btn-outline-danger">
                                    Delete Event
                                </button>
                            </form>

                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>