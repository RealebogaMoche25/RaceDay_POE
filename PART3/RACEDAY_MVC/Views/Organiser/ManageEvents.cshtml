```cshtml
@model List<RaceDay.Web.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
    var events = Model ?? new List<RaceDay.Web.ViewModels.EventViewModel>();
}

<div class="rd-manage-events-page">

    <!-- Page Header -->
    <section class="rd-manage-events-hero">
        <div class="rd-manage-events-hero-content">
            <span class="rd-dashboard-eyebrow">RACEDAY SA | EVENT OPERATIONS</span>

            <h1>Your events.<br />Your race to manage.</h1>

            <p>
                Keep your sporting events organised, manage registrations
                and oversee every detail from one place.
            </p>

            <a asp-controller="Organiser"
               asp-action="CreateEvent"
               class="rd-dashboard-primary-btn">
                + Create New Event
            </a>
        </div>

        <div class="rd-manage-events-decoration">
            <span>RACE</span>
            <strong>DAY</strong>
        </div>
    </section>

    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rd-manage-alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger rd-manage-alert">
            @ViewBag.ErrorMessage
        </div>
    }

    <!-- Event List Heading -->
    <section class="rd-manage-events-list-section">

        <div class="rd-manage-events-heading">
            <div>
                <span class="rd-section-eyebrow">YOUR EVENT PORTFOLIO</span>
                <h2>Manage your sporting events</h2>
                <p>View event information and access your management tools.</p>
            </div>

            <div class="rd-event-total">
                <strong>@events.Count</strong>
                <span>@(events.Count == 1 ? "EVENT" : "EVENTS")</span>
            </div>
        </div>

        @if (!events.Any())
        {
            <div class="rd-manage-empty-state">
                <div class="rd-empty-icon">+</div>
                <h3>Your next event starts here.</h3>
                <p>
                    You haven't created any sporting events yet.
                    Create your first event to get started.
                </p>

                <a asp-controller="Organiser"
                   asp-action="CreateEvent"
                   class="rd-dashboard-primary-btn">
                    Create Your First Event
                </a>
            </div>
        }
        else
        {
            <div class="rd-manage-event-grid">

                @foreach (var raceEvent in events)
                {
                    <article class="rd-manage-event-card">

                        <!-- Event Banner -->
                        <div class="rd-manage-event-image">

                            @if (!string.IsNullOrWhiteSpace(raceEvent.BannerImageViewUrl))
                            {
                                <img src="@raceEvent.BannerImageViewUrl"
                                     alt="Banner for @raceEvent.EventName"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="rd-manage-image-placeholder">
                                    <span>RACEDAY SA</span>
                                    <strong>EVERY RACE HAS A STORY.</strong>
                                </div>
                            }

                            <span class="rd-manage-event-type">
                                @(string.IsNullOrWhiteSpace(raceEvent.EventType)
                                    ? "Race Event"
                                    : raceEvent.EventType)
                            </span>

                        </div>

                        <!-- Event Information -->
                        <div class="rd-manage-event-body">

                            <div class="rd-manage-event-heading">
                                <div>
                                    <span class="rd-manage-event-id">
                                        EVENT #@raceEvent.EventId
                                    </span>

                                    <h3>@raceEvent.EventName</h3>
                                </div>
                            </div>

                            <p class="rd-manage-event-description">
                                @(string.IsNullOrWhiteSpace(raceEvent.EventDescription)
                                    ? "No event description provided."
                                    : raceEvent.EventDescription)
                            </p>

                            <div class="rd-manage-event-details">

                                <div>
                                    <span>DATE</span>
                                    <strong>@raceEvent.EventDate.ToString("dd MMM yyyy")</strong>
                                </div>

                                <div>
                                    <span>LOCATION</span>
                                    <strong>@(raceEvent.EventLocation ?? "Not specified")</strong>
                                </div>

                                <div>
                                    <span>DISTANCE</span>
                                    <strong>@raceEvent.EventDistance km</strong>
                                </div>

                            </div>

                            <!-- Primary Actions -->
                            <div class="rd-manage-primary-actions">

                                <a asp-controller="Organiser"
                                   asp-action="EditEvent"
                                   asp-route-id="@raceEvent.EventId"
                                   class="rd-manage-edit-btn">
                                    Edit Event
                                </a>

                                <form asp-controller="Organiser"
                                      asp-action="DeleteEvent"
                                      asp-route-id="@raceEvent.EventId"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this event?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="rd-manage-delete-btn">
                                        Delete
                                    </button>
                                </form>

                            </div>

                            <!-- Event Management Tools -->
                            <div class="rd-manage-tools">
                                <span class="rd-manage-tools-heading">
                                    EVENT MANAGEMENT TOOLS
                                </span>

                                <a asp-controller="Organiser"
                                   asp-action="ManageCategories"
                                   asp-route-eventId="@raceEvent.EventId">
                                    <span>Categories</span>
                                    <strong aria-hidden="true">&rarr;</strong>
                                </a>

                                <a asp-controller="Organiser"
                                   asp-action="ManageEnrolments"
                                   asp-route-eventId="@raceEvent.EventId">
                                    <span>Enrolments</span>
                                    <strong aria-hidden="true">&rarr;</strong>
                                </a>

                                <a asp-controller="Organiser"
                                   asp-action="ManageResults"
                                   asp-route-eventId="@raceEvent.EventId">
                                    <span>Results</span>
                                    <strong aria-hidden="true">&rarr;</strong>
                                </a>

                                <a asp-controller="Organiser"
                                   asp-action="ManageRoutes"
                                   asp-route-eventId="@raceEvent.EventId">
                                    <span>Routes</span>
                                    <strong aria-hidden="true">&rarr;</strong>
                                </a>

                            </div>

                        </div>
                    </article>
                }

            </div>
        }

    </section>

    <div class="rd-manage-events-footer">
        <a asp-controller="Organiser"
           asp-action="Dashboard">
            &larr; Back to Organiser Dashboard
        </a>

        <span>RACEDAY SA — DISCOVER. REGISTER. COMPETE.</span>
    </div>

</div>
```