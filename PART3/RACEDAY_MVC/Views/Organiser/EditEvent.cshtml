
@model RaceDay.Web.ViewModels.CreateEventViewModel

@{
    ViewData["Title"] = "Edit Event";
    var eventId = ViewContext.RouteData.Values["id"];
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white py-3">
                    <h2 class="mb-0">Edit Event</h2>
                </div>

                <div class="card-body p-4">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success" role="alert">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @TempData["ErrorMessage"]
                        </div>
                    }

                    @* EDIT EVENT DETAILS FORM *@
                    <form asp-controller="Organiser"
                          asp-action="EditEvent"
                          asp-route-id="@eventId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="EventName" class="form-label fw-semibold"></label>
                            <input asp-for="EventName" class="form-control" />
                            <span asp-validation-for="EventName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventDescription" class="form-label fw-semibold"></label>
                            <textarea asp-for="EventDescription"
                                      class="form-control"
                                      rows="4"></textarea>
                            <span asp-validation-for="EventDescription" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventDate" class="form-label fw-semibold"></label>
                            <input asp-for="EventDate"
                                   type="datetime-local"
                                   class="form-control" />
                            <span asp-validation-for="EventDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventLocation" class="form-label fw-semibold"></label>
                            <input asp-for="EventLocation" class="form-control" />
                            <span asp-validation-for="EventLocation" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventDistance" class="form-label fw-semibold"></label>
                            <input asp-for="EventDistance"
                                   type="number"
                                   step="0.01"
                                   class="form-control" />
                            <span asp-validation-for="EventDistance" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventType" class="form-label fw-semibold"></label>
                            <select asp-for="EventType" class="form-select">
                                <option value="">Select event type</option>
                                <option value="Running">Running</option>
                                <option value="Cycling">Cycling</option>
                                <option value="Swimming">Swimming</option>
                                <option value="Triathlon">Triathlon</option>
                                <option value="Walking">Walking</option>
                            </select>
                            <span asp-validation-for="EventType" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                Save Changes
                            </button>

                            <a asp-controller="Organiser"
                               asp-action="Events"
                               class="btn btn-outline-secondary btn-lg">
                                Cancel
                            </a>
                        </div>
                    </form>

                    <hr class="my-4" />

                    @* EVENT BANNER DISPLAY *@
                    <div class="mb-4">
                        <h5 class="fw-semibold mb-3">Event Banner</h5>

                        @if (!string.IsNullOrWhiteSpace(Model.BannerImageViewUrl))
                        {
                            <div class="mb-3">
                                <img src="@Model.BannerImageViewUrl"
                                     alt="Current banner for @Model.EventName"
                                     class="img-fluid rounded"
                                     style="max-height: 250px; width: 100%; object-fit: cover;" />
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">
                                No banner has been uploaded for this event yet.
                            </p>
                        }

                        <p class="text-muted">
                            Upload a new image to replace the current event banner.
                        </p>

                        @* SEPARATE BANNER UPLOAD FORM *@
                        <form asp-controller="Organiser"
                              asp-action="UploadEventBanner"
                              asp-route-id="@eventId"
                              method="post"
                              enctype="multipart/form-data">

                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label for="file" class="form-label fw-semibold">
                                    Choose Banner Image
                                </label>

                                <input type="file"
                                       name="file"
                                       id="file"
                                       class="form-control"
                                       accept=".jpg,.jpeg,.png,.webp"
                                       required />
                            </div>

                            <small class="text-muted">
                                Accepted formats: JPEG, PNG and WebP.
                                Maximum file size: 5 MB.
                            </small>

                            <div class="mt-3">
                                <button type="submit"
                                        class="btn btn-outline-primary">
                                    Upload Banner
                                </button>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
