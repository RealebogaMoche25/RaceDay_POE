
@model RaceDay.Web.ViewModels.ManageCategoriesViewModel

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Manage Categories</h2>
        <p class="text-muted">
            Manage categories for: <strong>@Model.EventName</strong>
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Organiser"
           asp-action="CreateCategory"
           asp-route-eventId="@Model.EventId"
           class="btn btn-primary">
            Create Category
        </a>

        <a asp-controller="Organiser"
           asp-action="ManageEvents"
           class="btn btn-outline-secondary">
            Back to My Events
        </a>
    </div>
</div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title">Event Categories</h5>

            @if (Model.Categories != null && Model.Categories.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Category Name</th>
                                <th>Description</th>
                                <th>Category ID</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var category in Model.Categories)
                            {
                                <tr>
                                    <td>@category.CategoryName</td>
                                    <td>@category.CategoryDescription</td>
                                    <td>@category.CategoryId</td>
                                    
<td>
    <div class="d-flex gap-2">

        <a asp-controller="Organiser"
           asp-action="EditCategory"
           asp-route-eventId="@Model.EventId"
           asp-route-categoryId="@category.CategoryId"
           class="btn btn-outline-primary btn-sm">
            Edit
        </a>

        <form asp-controller="Organiser"
              asp-action="DeleteCategory"
              asp-route-eventId="@Model.EventId"
              asp-route-categoryId="@category.CategoryId"
              method="post"
              onsubmit="return confirm('Are you sure you want to delete this category?');">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-outline-danger btn-sm">
                Delete
            </button>

        </form>

    </div>
</td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No categories have been added to this event yet.
                </p>
            }
        </div>
    </div>

</div>
