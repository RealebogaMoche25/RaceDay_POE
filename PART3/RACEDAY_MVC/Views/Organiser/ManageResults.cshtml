
@model RaceDay.Web.ViewModels.ManageResultsViewModel

@{
    ViewData["Title"] = "Manage Results";

    var enrolments = Model.Enrolments;
var results = Model.Results;

    var recordedCount = enrolments.Count(e =>
        results.Any(r => r.EnrolmentId == e.EnrolmentId));

    var pendingCount = enrolments.Count - recordedCount;
}

<div class="rd-manage-results-page">

    <!-- Page hero -->
    <section class="rd-results-hero">
        <div class="rd-results-hero-content">
            <span class="rd-results-eyebrow">EVENT MANAGEMENT</span>
            <h1>Manage Results</h1>
            <p>
                Record and manage race performances for
                <strong>@Model.EventName</strong>.
            </p>

            <div class="rd-results-event-label">
                <span>SELECTED EVENT</span>
                <strong>@Model.EventName</strong>
                <small>Event ID: @Model.EventId</small>
            </div>
        </div>

        <a asp-controller="Organiser"
           asp-action="ManageEvents"
           class="btn rd-results-back-btn">
            Back to My Events
        </a>
    </section>

    <!-- Feedback messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rd-results-alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rd-results-alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Results overview -->
    <section class="rd-results-overview">

        <div class="rd-results-section-heading">
            <div>
                <span class="rd-results-section-eyebrow">RACE PERFORMANCE</span>
                <h2>Participant Results</h2>
                <p>Track completed results and outstanding entries.</p>
            </div>
        </div>

        <div class="rd-results-stats">

            <div class="rd-results-stat-card">
                <div class="rd-results-stat-icon">01</div>
                <div>
                    <strong>@enrolments.Count</strong>
                    <span>Total Participants</span>
                </div>
            </div>

            <div class="rd-results-stat-card">
                <div class="rd-results-stat-icon rd-results-icon-recorded">02</div>
                <div>
                    <strong>@recordedCount</strong>
                    <span>Results Recorded</span>
                </div>
            </div>

            <div class="rd-results-stat-card">
                <div class="rd-results-stat-icon rd-results-icon-pending">03</div>
                <div>
                    <strong>@pendingCount</strong>
                    <span>Results Pending</span>
                </div>
            </div>

        </div>

        @if (!enrolments.Any())
        {
            <div class="rd-results-empty">
                <div class="rd-results-empty-icon">01</div>
                <h3>No participants registered</h3>
                <p>
                    Participants must enrol in this event before their
                    race results can be entered.
                </p>

                <a asp-controller="Organiser"
                   asp-action="ManageEvents"
                   class="btn rd-results-empty-btn">
                    Return to My Events
                </a>
            </div>
        }
        else
        {
            <div class="rd-results-table-card">

                <div class="rd-results-table-heading">
                    <div>
                        <h3>Race Results Register</h3>
                        <p>Manage the finishing performance of each participant.</p>
                    </div>

                    <span class="rd-results-total-badge">
                        @enrolments.Count @(enrolments.Count == 1 ? "participant" : "participants")
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table rd-results-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Participant</th>
                                <th>Category</th>
                                <th>Finish Time</th>
                                <th>Position</th>
                                <th>Result Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var enrolment in enrolments)
                            {
                                var result = results.FirstOrDefault(
                                    r => r.EnrolmentId == enrolment.EnrolmentId);

                                <tr>
                                    <td>
                                        <div class="rd-results-participant">
                                            <div class="rd-results-avatar">
                                                @(string.IsNullOrWhiteSpace(enrolment.ParticipantName)
                                                    ? "P"
                                                    : enrolment.ParticipantName.Substring(0, 1).ToUpper())
                                            </div>

                                            <div>
                                                <strong>@enrolment.ParticipantName</strong>
                                                <small>
                                                    Participant ID: @enrolment.ParticipantId
                                                </small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="rd-results-category">
                                            @enrolment.CategoryName
                                        </span>
                                    </td>

                                    <td>
                                        @if (result != null)
                                        {
                                            <span class="rd-results-time">
                                                @result.FinishTime.ToString(@"hh\:mm\:ss")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="rd-results-not-recorded">
                                                Not recorded
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (result != null)
                                        {
                                            <span class="rd-results-position">
                                                #@result.FinishingPosition
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="rd-results-not-recorded">—</span>
                                        }
                                    </td>

                                    <td>
                                        @if (result != null)
                                        {
                                            <span class="rd-results-status rd-results-status-recorded">
                                                <span></span> Recorded
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="rd-results-status rd-results-status-pending">
                                                <span></span> Pending
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="rd-results-action">
                                            @if (result == null)
                                            {
                                                <a asp-controller="Organiser"
                                                   asp-action="EnterResult"
                                                   asp-route-eventId="@Model.EventId"
                                                   asp-route-enrolmentId="@enrolment.EnrolmentId"
                                                   class="btn rd-results-enter-btn btn-sm">
                                                    Enter Result
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-controller="Organiser"
                                                   asp-action="EditResult"
                                                   asp-route-eventId="@Model.EventId"
                                                   asp-route-resultId="@result.ResultId"
                                                   class="btn rd-results-edit-btn btn-sm">
                                                    Edit Result
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        }

    </section>

</div>
