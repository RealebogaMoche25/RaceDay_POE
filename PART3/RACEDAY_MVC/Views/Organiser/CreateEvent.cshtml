@model RaceDay.Web.ViewModels.CreateEventViewModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="container py-5">

    <div class="mb-4">
        <a asp-controller="Organiser"
           asp-action="Dashboard"
           class="btn btn-outline-secondary mb-3">
            Back to Dashboard
        </a>

        <h1 class="fw-bold">Create New Event</h1>
        <p class="text-muted">
            Enter the details below to publish a new RaceDay event.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">

            <form asp-controller="Organiser"
                  asp-action="CreateEvent"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="mb-3">
                    <label asp-for="EventName" class="form-label">
                        Event Name
                    </label>
                    <input asp-for="EventName"
                           class="form-control"
                           placeholder="Enter event name" />
                    <span asp-validation-for="EventName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventDescription"
                           class="form-label">
                        Event Description
                    </label>
                    <textarea asp-for="EventDescription"
                              class="form-control"
                              rows="4"
                              placeholder="Describe your event"></textarea>
                    <span asp-validation-for="EventDescription"
                          class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventDate"
                               class="form-label">
                            Event Date
                        </label>
                        <input asp-for="EventDate"
                               type="datetime-local"
                               class="form-control" />
                        <span asp-validation-for="EventDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="EventLocation"
                               class="form-label">
                            Event Location
                        </label>
                        <input asp-for="EventLocation"
                               class="form-control"
                               placeholder="e.g. Johannesburg" />
                        <span asp-validation-for="EventLocation"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventDistance"
                               class="form-label">
                            Event Distance
                        </label>
                        <input asp-for="EventDistance"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control"
                               placeholder="e.g. 10.5" />

                        <span asp-validation-for="EventDistance"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="EventType"
                               class="form-label">
                            Event Type
                        </label>
                        <select asp-for="EventType"
                                class="form-select">
                            <option value="">Select event type</option>
                            <option value="Running">Running</option>
                            <option value="Cycling">Cycling</option>
                            <option value="Swimming">Swimming</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="EventType"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="BannerImageUrl"
                           class="form-label">
                        Banner Image URL
                    </label>
                    <input asp-for="BannerImageUrl"
                           class="form-control"
                           placeholder="Enter an image URL (optional)" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary btn-lg">
                        Create Event
                    </button>

                    <a asp-controller="Organiser"
                       asp-action="Dashboard"
                       class="btn btn-outline-secondary btn-lg">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
