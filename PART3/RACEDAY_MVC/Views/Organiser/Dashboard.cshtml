@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container py-5">

    <div class="mb-5">
        <h1 class="fw-bold">Organiser Dashboard</h1>
        <p class="text-muted">
            Welcome to your RaceDay organiser portal.
            Manage your events, categories, participants and race results.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold">Manage Events</h5>
                    <p class="text-muted">
                        Create, update and manage your sporting events.
                    </p>
                    <a asp-controller="Organiser"
                       asp-action="ManageEvents"
                       class="btn btn-primary">
                        Manage Events
                    </a>
                    <a asp-controller="Organiser"
                       asp-action="CreateEvent"
                       class="btn btn-outline-primary ms-2">
                        Create Event
                    </a>
                </div>
            </div>
        </div>

        
<div class="col-md-6 col-lg-4">
    <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
            <h5 class="fw-bold">Manage Categories</h5>
            <p class="text-muted">
                Create, update and manage categories for your sporting events.
            </p>
            <a asp-controller="Organiser"
               asp-action="ManageEvents"
               class="btn btn-primary">
                Select Event
            </a>
        </div>
    </div>
</div>


       <div class="col-md-6 col-lg-4">
    <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
            <h5 class="fw-bold">Manage Enrolments</h5>

            <p class="text-muted">
                View participants registered for your sporting events,
                including their categories and enrolment details.
            </p>

            <a asp-controller="Organiser"
               asp-action="ManageEvents"
               class="btn btn-primary">
                Select Event
            </a>
        </div>
    </div>
</div>

        <div class="col-md-6 col-lg-4">
    <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
            <h5 class="fw-bold">Manage Results</h5>

            <p class="text-muted">
                Record and update participants' finishing times
                and positions for your sporting events.
            </p>

            <a asp-controller="Organiser"
               asp-action="ManageEvents"
               class="btn btn-primary">
                Select Event
            </a>
        </div>
    </div>
</div>



<div class="col-md-6 col-lg-4 mb-4">
    <div class="card shadow-sm h-100">
        <div class="card-body">
            <h5 class="card-title">Manage Routes</h5>

            <p class="card-text">
                Create, update and manage event routes.
                Add route descriptions, locations and external map links.
            </p>

            <a asp-controller="Organiser"
               asp-action="ManageEvents"
               class="btn btn-outline-info">
                Select Event
            </a>
        </div>
    </div>
</div>

    </div>

</div>