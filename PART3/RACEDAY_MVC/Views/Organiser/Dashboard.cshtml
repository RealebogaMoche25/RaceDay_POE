@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container py-5">

    <div class="mb-5">
        <h1 class="fw-bold">Organiser Dashboard</h1>
        <p class="text-muted">
            Welcome to your RaceDay organiser portal.
            Manage your events, categories, participants and race results.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold">Manage Events</h5>
                    <p class="text-muted">
                        Create, update and manage your sporting events.
                    </p>
                    <a asp-controller="Organiser"
                       asp-action="ManageEvents"
                       class="btn btn-primary">
                        Manage Events
                    </a>
                    <a asp-controller="Organiser"
                       asp-action="CreateEvent"
                       class="btn btn-outline-primary ms-2">
                        Create Event
                    </a>
                </div>
            </div>
        </div>

        
<div class="col-md-6 col-lg-4">
    <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
            <h5 class="fw-bold">Manage Categories</h5>
            <p class="text-muted">
                Create, update and manage categories for your sporting events.
            </p>
            <a asp-controller="Organiser"
               asp-action="ManageEvents"
               class="btn btn-primary">
                Select Event
            </a>
        </div>
    </div>
</div>


        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold">Manage Enrolments</h5>
                    <p class="text-muted">
                        Review participants registered for your events.
                    </p>
                    <span class="badge bg-secondary">Coming soon</span>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold">Enter Results</h5>
                    <p class="text-muted">
                        Record finishing times and race positions.
                    </p>
                    <span class="badge bg-secondary">Coming soon</span>
                </div>
            </div>
        </div>

    </div>

</div>