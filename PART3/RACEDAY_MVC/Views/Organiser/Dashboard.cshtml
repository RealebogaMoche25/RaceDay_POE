```cshtml
@model RaceDay.Web.ViewModels.OrganiserDashboardViewModel

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="rd-dashboard-page">

    <!-- Dashboard Welcome -->
    <section class="rd-dashboard-hero">
        <div class="rd-dashboard-hero-content">
            <span class="rd-dashboard-eyebrow">RACEDAY SA | ORGANISER PORTAL</span>

            <h1>Take control of<br />your next race.</h1>

            <p>
                Your event management hub. Create events, manage participants,
                organise race routes and keep track of results.
            </p>

            <a asp-controller="Organiser"
               asp-action="CreateEvent"
               class="rd-dashboard-primary-btn">
                + Create New Event
            </a>
        </div>

        <div class="rd-dashboard-hero-decoration">
            <span class="rd-dashboard-number">01</span>
            <span class="rd-dashboard-decoration-line"></span>
            <span class="rd-dashboard-decoration-text">PLAN. ORGANISE. DELIVER.</span>
        </div>
    </section>

    <!-- Dashboard Statistics -->
    <section class="rd-dashboard-stats-section">

        <div class="rd-dashboard-section-heading">
            <div>
                <span class="rd-section-eyebrow">YOUR PERFORMANCE</span>
                <h2>Dashboard overview</h2>
            </div>

            <span class="rd-dashboard-live-label">
                ORGANISER SUMMARY
            </span>
        </div>

        <div class="rd-dashboard-stats-grid">

            <div class="rd-stat-card">
                <div class="rd-stat-card-top">
                    <span>Total Events</span>
                    <span class="rd-stat-icon">01</span>
                </div>
                <h3>@Model.TotalEvents</h3>
                <p>Events created</p>
                <div class="rd-stat-accent"></div>
            </div>

            <div class="rd-stat-card">
                <div class="rd-stat-card-top">
                    <span>Total Enrolments</span>
                    <span class="rd-stat-icon">02</span>
                </div>
                <h3>@Model.TotalEnrolments</h3>
                <p>Across your events</p>
                <div class="rd-stat-accent"></div>
            </div>

            <div class="rd-stat-card">
                <div class="rd-stat-card-top">
                    <span>Upcoming Events</span>
                    <span class="rd-stat-icon">03</span>
                </div>
                <h3>@Model.UpcomingEvents</h3>
                <p>Events still to take place</p>
                <div class="rd-stat-accent"></div>
            </div>

            <div class="rd-stat-card rd-next-event-card">
                <div class="rd-stat-card-top">
                    <span>Next Upcoming Event</span>
                    <span class="rd-stat-icon rd-next-icon">04</span>
                </div>

                <h3 class="rd-next-event-name">
                    @(string.IsNullOrWhiteSpace(Model.NextEventName)
                        ? "No event scheduled"
                        : Model.NextEventName)
                </h3>

                @if (Model.NextEventDate.HasValue)
                {
                    <p>@Model.NextEventDate.Value.ToString("dd MMMM yyyy")</p>
                }
                else
                {
                    <p>Create an event to get started</p>
                }

                <div class="rd-stat-accent"></div>
            </div>

        </div>
    </section>

    <!-- Management Tools -->
    <section class="rd-dashboard-management">

        <div class="rd-dashboard-section-heading">
            <div>
                <span class="rd-section-eyebrow">EVENT OPERATIONS</span>
                <h2>Manage your RaceDay</h2>
                <p>Everything you need to organise a successful sporting event.</p>
            </div>
        </div>

        <div class="rd-management-grid">

            <!-- Events -->
            <article class="rd-management-card rd-management-featured">
                <div class="rd-management-card-top">
                    <span class="rd-management-number">01 / EVENTS</span>
                    <span class="rd-management-icon">E</span>
                </div>

                <h3>Manage Events</h3>

                <p>
                    Create new sporting events, update event information
                    and manage your existing race listings.
                </p>

                <div class="rd-management-actions">
                    <a asp-controller="Organiser"
                       asp-action="ManageEvents"
                       class="rd-management-btn">
                        Manage Events
                    </a>

                    <a asp-controller="Organiser"
                       asp-action="CreateEvent"
                       class="rd-management-secondary">
                        Create Event <span aria-hidden="true">&rarr;</span>
                    </a>
                </div>
            </article>

            <!-- Categories -->
            <article class="rd-management-card">
                <div class="rd-management-card-top">
                    <span class="rd-management-number">02 / CATEGORIES</span>
                    <span class="rd-management-icon">C</span>
                </div>

                <h3>Manage Categories</h3>

                <p>
                    Organise race divisions and create categories
                    suited to different participants and distances.
                </p>

                <a asp-controller="Organiser"
                   asp-action="ManageEvents"
                   class="rd-management-link">
                    Select Event <span aria-hidden="true">&rarr;</span>
                </a>
            </article>

            <!-- Enrolments -->
            <article class="rd-management-card">
                <div class="rd-management-card-top">
                    <span class="rd-management-number">03 / ENROLMENTS</span>
                    <span class="rd-management-icon">P</span>
                </div>

                <h3>Manage Enrolments</h3>

                <p>
                    View registered participants, their selected
                    categories and their enrolment information.
                </p>

                <a asp-controller="Organiser"
                   asp-action="ManageEvents"
                   class="rd-management-link">
                    Select Event <span aria-hidden="true">&rarr;</span>
                </a>
            </article>

            <!-- Results -->
            <article class="rd-management-card">
                <div class="rd-management-card-top">
                    <span class="rd-management-number">04 / RESULTS</span>
                    <span class="rd-management-icon">R</span>
                </div>

                <h3>Manage Results</h3>

                <p>
                    Record finishing times, update race positions
                    and manage participants' event results.
                </p>

                <a asp-controller="Organiser"
                   asp-action="ManageEvents"
                   class="rd-management-link">
                    Select Event <span aria-hidden="true">&rarr;</span>
                </a>
            </article>

            <!-- Routes -->
            <article class="rd-management-card">
                <div class="rd-management-card-top">
                    <span class="rd-management-number">05 / ROUTES</span>
                    <span class="rd-management-icon">T</span>
                </div>

                <h3>Manage Routes</h3>

                <p>
                    Create and update race routes with descriptions,
                    locations and external map links.
                </p>

                <a asp-controller="Organiser"
                   asp-action="ManageEvents"
                   class="rd-management-link">
                    Select Event <span aria-hidden="true">&rarr;</span>
                </a>
            </article>

        </div>
    </section>

    <!-- Closing Dashboard Banner -->
    <section class="rd-dashboard-bottom-banner">
        <div>
            <span>RACEDAY SA</span>
            <h2>Great events start with great organisation.</h2>
        </div>

        <a asp-controller="Organiser"
           asp-action="ManageEvents"
           class="rd-dashboard-bottom-link">
            View Your Events <span aria-hidden="true">&rarr;</span>
        </a>
    </section>

</div>
```