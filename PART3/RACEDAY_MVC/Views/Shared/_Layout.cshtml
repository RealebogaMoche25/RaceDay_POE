
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.Web.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg rd-navbar">
            <div class="container">

                <a class="navbar-brand rd-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    Race<span>Day</span>
                </a>

                <button class="navbar-toggler rd-navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#raceDayNavbar"
                        aria-controls="raceDayNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="raceDayNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link rd-nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            var role = Context.Session.GetString("Role");
                            var firstName = Context.Session.GetString("FirstName");

                            @if (role == "Organiser")
                            {
                                <li class="nav-item">
                                    <a class="nav-link rd-nav-link"
                                       asp-controller="Organiser"
                                       asp-action="Dashboard">
                                        Dashboard
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link rd-nav-link"
                                       asp-controller="Events"
                                       asp-action="Index">
                                        Manage Events
                                    </a>
                                </li>
                            }
                            else if (role == "Participant")
                            {
                                <li class="nav-item">
                                    <a class="nav-link rd-nav-link"
                                       asp-controller="Events"
                                       asp-action="Index">
                                        Browse Events
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link rd-nav-link"
                                       asp-controller="Participant"
                                       asp-action="MyEvents">
                                        My Events
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link rd-nav-link"
                                       asp-controller="Participant"
                                       asp-action="MyResults">
                                        My Results
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link rd-nav-link"
                                       asp-controller="Participant"
                                       asp-action="MyProfile">
                                        My Profile
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-3">

                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            var firstName = Context.Session.GetString("FirstName");

                            <span class="rd-welcome">
                                Welcome, @firstName
                            </span>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn rd-logout-btn">
                                    Log Out
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="rd-login-link"
                               asp-controller="Account"
                               asp-action="Login">
                                Login
                            </a>

                            <a class="btn rd-register-btn"
                               asp-controller="Account"
                               asp-action="Register">
                                Register
                            </a>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <div class="container rd-main-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="rd-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <span>&copy; 2026 RaceDay. All rights reserved.</span>

            <a asp-controller="Home"
               asp-action="Privacy">
                Privacy Policy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
