@model List<RaceDay.Web.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "Browse Events";

    var events = Model ?? new List<RaceDay.Web.ViewModels.EventViewModel>();

    var locations = events
        .Where(e => !string.IsNullOrWhiteSpace(e.EventLocation))
        .Select(e => e.EventLocation!)
        .Distinct()
        .OrderBy(location => location)
        .ToList();

    var eventTypes = events
        .Where(e => !string.IsNullOrWhiteSpace(e.EventType))
        .Select(e => e.EventType!)
        .Distinct()
        .OrderBy(type => type)
        .ToList();
}

<div class="rd-events-page">

    <!-- PAGE HERO -->
    <section class="rd-events-hero">
        <div class="rd-events-hero-overlay"></div>

        <div class="rd-events-hero-content">
            <span class="rd-events-eyebrow">
                THE RACEDAY EXPERIENCE
            </span>

            <h1>
                Find your next<br />
                <span>challenge.</span>
            </h1>

            <p>
                From your first starting line to your next big finish,
                discover events that inspire you to go further.
            </p>

            <a href="#eventDiscovery" class="rd-events-hero-link">
                Explore Events
                <span aria-hidden="true">↓</span>
            </a>
        </div>

        <div class="rd-events-hero-caption">
            DISCOVER. REGISTER. COMPETE.
        </div>
    </section>

    <div class="container rd-events-container" id="eventDiscovery">

        <!-- PAGE INTRODUCTION -->
        <div class="rd-events-intro">
            <div>
                <span class="rd-section-kicker">WHAT'S HAPPENING?</span>
                <h2>Explore RaceDay Events</h2>
                <p>
                    Find an event, choose your challenge and get ready
                    to make your mark.
                </p>
            </div>

            <div class="rd-events-intro-mark">
                <span>RD</span>
                <small>RACE YOUR WAY</small>
            </div>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-warning" role="alert">
                @ViewBag.ErrorMessage
            </div>
        }
        else
        {
            <!-- EVENT SEARCH AND FILTERS -->
            <section class="rd-event-filter-panel">
                <div class="rd-filter-heading">
                    <div>
                        <span class="rd-section-kicker">FIND YOUR FIT</span>
                        <h3>Find an Event</h3>
                    </div>

                    <span class="rd-filter-icon" aria-hidden="true">⌕</span>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-lg-4">
                        <label for="eventSearch" class="rd-filter-label">
                            Search events
                        </label>

                        <input type="search"
                               id="eventSearch"
                               class="form-control rd-filter-input"
                               placeholder="Search by event name..." />
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <label for="locationFilter" class="rd-filter-label">
                            Location
                        </label>

                        <select id="locationFilter"
                                class="form-select rd-filter-input">
                            <option value="">All locations</option>

                            @foreach (var location in locations)
                            {
                                <option value="@location">@location</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <label for="typeFilter" class="rd-filter-label">
                            Event category
                        </label>

                        <select id="typeFilter"
                                class="form-select rd-filter-input">
                            <option value="">All event types</option>

                            @foreach (var type in eventTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="rd-filter-footer">
                    <button type="button"
                            id="clearFilters"
                            class="rd-clear-filter">
                        <span aria-hidden="true">↻</span>
                        Clear Filters
                    </button>

                    <span id="eventCount"
                          class="rd-event-count"
                          aria-live="polite">
                    </span>
                </div>
            </section>

            <!-- EVENT LISTINGS -->
            <div class="rd-listing-heading">
                <div>
                    <span class="rd-section-kicker">YOUR NEXT STARTING LINE</span>
                    <h3>Upcoming Opportunities</h3>
                </div>
            </div>

            @if (!events.Any())
            {
                <div class="rd-events-empty">
                    <div class="rd-empty-icon">RD</div>
                    <h3>No events available just yet.</h3>
                    <p>
                        Check back soon. New challenges may be added
                        to RaceDay.
                    </p>
                </div>
            }
            else
            {
                <div class="row g-4" id="eventCards">

                    @foreach (var raceEvent in events)
                    {
                        <div class="col-12 col-md-6 col-xl-4 event-card"
                             data-name="@raceEvent.EventName"
                             data-location="@raceEvent.EventLocation"
                             data-type="@raceEvent.EventType">

                            <article class="rd-event-card">

                                <!-- EVENT BANNER -->
                                <div class="rd-event-image">
                                    @if (!string.IsNullOrWhiteSpace(raceEvent.BannerImageViewUrl))
                                    {
                                        <img src="@raceEvent.BannerImageViewUrl"
                                             alt="Banner for @raceEvent.EventName"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="rd-event-image-placeholder">
                                            <span>RACE<span>DAY</span></span>
                                            <small>YOUR NEXT CHALLENGE</small>
                                        </div>
                                    }

                                    <span class="rd-event-category">
                                        @(string.IsNullOrWhiteSpace(raceEvent.EventType)
                                            ? "Race Event"
                                            : raceEvent.EventType)
                                    </span>
                                </div>

                                <!-- EVENT INFORMATION -->
                                <div class="rd-event-card-body">

                                    <h4>@raceEvent.EventName</h4>

                                    <p class="rd-event-description">
                                        @raceEvent.EventDescription
                                    </p>

                                    <div class="rd-event-details">

                                        <div class="rd-event-detail">
                                            <span class="rd-detail-icon"
                                                  aria-hidden="true">◷</span>
                                            <div>
                                                <small>EVENT DATE</small>
                                                <strong>
                                                    @raceEvent.EventDate.ToString("dd MMM yyyy, HH:mm")
                                                </strong>
                                            </div>
                                        </div>

                                        <div class="rd-event-detail">
                                            <span class="rd-detail-icon"
                                                  aria-hidden="true">⌖</span>
                                            <div>
                                                <small>LOCATION</small>
                                                <strong>
                                                    @(raceEvent.EventLocation ?? "Not specified")
                                                </strong>
                                            </div>
                                        </div>

                                        <div class="rd-event-detail">
                                            <span class="rd-detail-icon"
                                                  aria-hidden="true">↗</span>
                                            <div>
                                                <small>DISTANCE</small>
                                                <strong>
                                                    @raceEvent.EventDistance km
                                                </strong>
                                            </div>
                                        </div>

                                    </div>

                                    <a asp-controller="Events"
                                       asp-action="Details"
                                       asp-route-id="@raceEvent.EventId"
                                       class="rd-event-view-btn">
                                        View Event Details
                                        <span aria-hidden="true">→</span>
                                    </a>

                                </div>
                            </article>

                        </div>
                    }

                </div>

                <!-- NO MATCHING EVENTS -->
                <div id="noMatchingEvents"
                     class="rd-events-empty"
                     role="status"
                     style="display: none;">

                    <div class="rd-empty-icon">RD</div>

                    <h3>No matching events found.</h3>

                    <p>
                        Try another search or adjust your filters
                        to discover more events.
                    </p>
                </div>
            }
        }

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput = document.getElementById("eventSearch");
            const locationFilter = document.getElementById("locationFilter");
            const typeFilter = document.getElementById("typeFilter");
            const clearButton = document.getElementById("clearFilters");
            const eventCards = document.querySelectorAll(".event-card");
            const eventCount = document.getElementById("eventCount");
            const noMatchingEvents = document.getElementById("noMatchingEvents");

            if (!searchInput || !locationFilter || !typeFilter ||
                !clearButton || !eventCount || !noMatchingEvents) {
                return;
            }

            function filterEvents() {

                const searchTerm = searchInput.value.trim().toLowerCase();
                const selectedLocation = locationFilter.value.toLowerCase();
                const selectedType = typeFilter.value.toLowerCase();

                let visibleCount = 0;

                eventCards.forEach(function (card) {

                    const name = (card.dataset.name || "").toLowerCase();
                    const location = (card.dataset.location || "").toLowerCase();
                    const type = (card.dataset.type || "").toLowerCase();

                    const matchesName = name.includes(searchTerm);

                    const matchesLocation =
                        selectedLocation === "" ||
                        location === selectedLocation;

                    const matchesType =
                        selectedType === "" ||
                        type === selectedType;

                    const matches =
                        matchesName && matchesLocation && matchesType;

                    card.style.display = matches ? "" : "none";

                    if (matches) {
                        visibleCount++;
                    }
                });

                eventCount.textContent =
                    visibleCount + (visibleCount === 1
                        ? " event found"
                        : " events found");

                noMatchingEvents.style.display =
                    visibleCount === 0 ? "" : "none";
            }

            searchInput.addEventListener("input", filterEvents);
            locationFilter.addEventListener("change", filterEvents);
            typeFilter.addEventListener("change", filterEvents);

            clearButton.addEventListener("click", function () {
                searchInput.value = "";
                locationFilter.value = "";
                typeFilter.value = "";

                filterEvents();
                searchInput.focus();
            });

            filterEvents();
        });
    </script>
}
