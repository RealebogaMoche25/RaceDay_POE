
@model List<RaceDay.Web.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "Browse Events";
}

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-md-center mb-4">
        <div>
            <h1 class="fw-bold">RaceDay Events</h1>
            <p class="text-muted mb-0">
                Discover upcoming races and community events.
            </p>
        </div>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-warning" role="alert">
            @ViewBag.ErrorMessage
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-info" role="alert">
            No events are available at the moment.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var raceEvent in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        @if (!string.IsNullOrWhiteSpace(raceEvent.BannerImageUrl)
                             && Uri.IsWellFormedUriString(
                                 raceEvent.BannerImageUrl, UriKind.Absolute)
                             && (raceEvent.BannerImageUrl.StartsWith(
                                     "https://", StringComparison.OrdinalIgnoreCase)
                                 || raceEvent.BannerImageUrl.StartsWith(
                                     "http://", StringComparison.OrdinalIgnoreCase)))
                        {
                            <img src="@raceEvent.BannerImageUrl"
                                 class="card-img-top"
                                 alt="Banner for @raceEvent.EventName"
                                 style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-primary text-white d-flex
                                        align-items-center justify-content-center"
                                 style="height: 200px;">
                                <span class="fw-bold fs-4">RaceDay</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge bg-primary">
                                    @(string.IsNullOrWhiteSpace(raceEvent.EventType)
                                        ? "Race Event"
                                        : raceEvent.EventType)
                                </span>
                            </div>

                            <h2 class="h5 fw-bold">
                                @raceEvent.EventName
                            </h2>

                            <p class="text-muted small">
                                @raceEvent.EventDescription
                            </p>

                            <p class="mb-1">
                                <strong>Date:</strong>
                                @raceEvent.EventDate.ToString("dd MMM yyyy, HH:mm")
                            </p>

                            <p class="mb-1">
                                <strong>Location:</strong>
                                @(raceEvent.EventLocation ?? "Not specified")
                            </p>

                            <p class="mb-3">
                                <strong>Distance:</strong>
                                @raceEvent.EventDistance km
                            </p>

                            <div class="mt-auto">
                                <a asp-controller="Events"
                                   asp-action="Details"
                                   asp-route-id="@raceEvent.EventId"
                                   class="btn btn-outline-primary w-100">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

