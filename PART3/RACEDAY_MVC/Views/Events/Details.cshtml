
@model RaceDay.Web.ViewModels.EventDetailsViewModel

@{
    ViewData["Title"] = "Event Details";
    var raceEvent = Model.Event;
    var isParticipant = Context.Session.GetString("Role") == "Participant";
}

<div class="container py-5">
    <a asp-controller="Events"
       asp-action="Index"
       class="btn btn-outline-secondary mb-4">
        &larr; Back to Events
    </a>

    <div class="card border-0 shadow-sm overflow-hidden">
@if (!string.IsNullOrWhiteSpace(raceEvent.BannerImageViewUrl))
{
    <img src="@raceEvent.BannerImageViewUrl"
         alt="Banner for @raceEvent.EventName"
         class="w-100"
         style="max-height: 350px; object-fit: cover;" />
}

        <div class="card-body p-4 p-md-5">

            <span class="badge bg-primary mb-3">
                @(string.IsNullOrWhiteSpace(raceEvent.EventType)
                    ? "Race Event"
                    : raceEvent.EventType)
            </span>

            <h1 class="fw-bold mb-3">@raceEvent.EventName</h1>

            <p class="text-muted mb-4">
                @raceEvent.EventDescription
            </p>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <strong>Date and Time</strong>
                    <p>@raceEvent.EventDate.ToString("dd MMMM yyyy, HH:mm")</p>
                </div>

                <div class="col-12 col-md-6">
                    <strong>Location</strong>
                    <p>@(raceEvent.EventLocation ?? "Not specified")</p>
                </div>

                <div class="col-12 col-md-6">
                    <strong>Distance</strong>
                    <p>@raceEvent.EventDistance km</p>
                </div>

                <div class="col-12 col-md-6">
                    <strong>Event Type</strong>
                    <p>@(raceEvent.EventType ?? "Not specified")</p>
                </div>
            </div>

            <hr class="my-4" />

            <h3 class="fw-bold mb-3">Available Categories</h3>

            @if (Model.Categories.Any())
            {
                @if (isParticipant)
                {
                    <form asp-controller="Enrolment"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="EventId"
                               value="@raceEvent.EventId" />

                        <div class="mb-3">
                            <label for="SelectedCategoryId"
                                   class="form-label fw-semibold">
                                Select your race category
                            </label>

                            <select name="CategoryId"
                                    id="SelectedCategoryId"
                                    class="form-select"
                                    required>
                                <option value="">Choose a category</option>

                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.CategoryId">
                                        @category.CategoryName
                                    </option>
                                }
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg">
                            Enrol Now
                        </button>
                    </form>
                }

                @foreach (var category in Model.Categories)
                {
                    <div class="card border mb-3">
                        <div class="card-body">
                            <h5 class="fw-bold">@category.CategoryName</h5>
                            <p class="text-muted mb-0">
                                @category.CategoryDescription
                            </p>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info">
                    No categories have been added to this event yet.
                </div>
            }

        </div>
    </div>
</div>
