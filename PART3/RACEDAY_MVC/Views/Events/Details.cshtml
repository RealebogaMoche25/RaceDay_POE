
@model RaceDay.Web.ViewModels.EventViewModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="container py-5">
    <a asp-controller="Events"
       asp-action="Index"
       class="btn btn-outline-secondary mb-4">
        &larr; Back to Events
    </a>

    <div class="card border-0 shadow-sm overflow-hidden">
        @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl)
             && Uri.IsWellFormedUriString(Model.BannerImageUrl, UriKind.Absolute)
             && (Model.BannerImageUrl.StartsWith(
                     "https://", StringComparison.OrdinalIgnoreCase)
                 || Model.BannerImageUrl.StartsWith(
                     "http://", StringComparison.OrdinalIgnoreCase)))
        {
            <img src="@Model.BannerImageUrl"
                 alt="Banner for @Model.EventName"
                 class="w-100"
                 style="max-height: 350px; object-fit: cover;" />
        }

        <div class="card-body p-4 p-md-5">
            <span class="badge bg-primary mb-3">
                @(string.IsNullOrWhiteSpace(Model.EventType)
                    ? "Race Event"
                    : Model.EventType)
            </span>

            <h1 class="fw-bold mb-3">@Model.EventName</h1>

            <p class="text-muted mb-4">
                @Model.EventDescription
            </p>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <strong>Date and Time</strong>
                    <p>@Model.EventDate.ToString("dd MMMM yyyy, HH:mm")</p>
                </div>

                <div class="col-12 col-md-6">
                    <strong>Location</strong>
                    <p>@(Model.EventLocation ?? "Not specified")</p>
                </div>

                <div class="col-12 col-md-6">
                    <strong>Distance</strong>
                    <p>@Model.EventDistance km</p>
                </div>

                <div class="col-12 col-md-6">
                    <strong>Event Type</strong>
                    <p>@(Model.EventType ?? "Not specified")</p>
                </div>
            </div>
        </div>
    </div>
</div>
