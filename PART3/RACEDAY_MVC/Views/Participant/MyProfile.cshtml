
@model RaceDay.Web.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="rd-my-profile-page">

    <section class="rd-my-profile-hero">
        <div>
            <span class="rd-my-profile-eyebrow">YOUR RACEDAY ACCOUNT</span>
            <h1>My Profile</h1>
            <p>
                Keep your personal information up to date and make your
                RaceDay account your own.
            </p>
        </div>
    </section>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="rd-profile-layout">

        <!-- Profile picture -->
        <section class="rd-profile-picture-card">

            <div class="rd-profile-card-heading">
                <span class="rd-profile-section-eyebrow">PROFILE PHOTO</span>
                <h2>Your Picture</h2>
                <p>Choose a picture to personalise your account.</p>
            </div>

            <div class="rd-profile-picture-preview">
                @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureViewUrl))
                {
                    <img src="@Model.ProfilePictureViewUrl"
                         alt="Your profile picture"
                         class="rd-profile-picture" />
                }
                else
                {
                    <div class="rd-profile-picture-placeholder">
                        <span>RD</span>
                    </div>
                }
            </div>

            <form asp-controller="Participant"
                  asp-action="UploadProfilePicture"
                  method="post"
                  enctype="multipart/form-data"
                  class="rd-profile-upload-form">

                @Html.AntiForgeryToken()

                <label for="profilePictureFile" class="rd-profile-upload-label">
                    Choose a profile picture
                </label>

                <input type="file"
                       id="profilePictureFile"
                       name="file"
                       class="form-control rd-profile-file-input"
                       accept=".jpg,.jpeg,.png,.webp"
                       required />

                <button type="submit" class="btn rd-profile-upload-btn">
                    Upload Picture
                </button>

                <p class="rd-profile-upload-help">
                    Accepted formats: JPEG, PNG and WebP.
                    Maximum file size: 5 MB.
                </p>

            </form>

        </section>

        <!-- Personal information -->
        <section class="rd-profile-information-card">

            <div class="rd-profile-card-heading">
                <span class="rd-profile-section-eyebrow">ACCOUNT DETAILS</span>
                <h2>Personal Information</h2>
                <p>Update the details associated with your account.</p>
            </div>

            <form asp-controller="Participant"
                  asp-action="MyProfile"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <input type="hidden" asp-for="UserId" />

                <div class="rd-profile-form-grid">

                    <div class="rd-profile-form-group">
                        <label asp-for="FirstName" class="form-label">
                            First Name
                        </label>

                        <input asp-for="FirstName"
                               class="form-control rd-profile-input" />

                        <span asp-validation-for="FirstName"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="rd-profile-form-group">
                        <label asp-for="LastName" class="form-label">
                            Last Name
                        </label>

                        <input asp-for="LastName"
                               class="form-control rd-profile-input" />

                        <span asp-validation-for="LastName"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="rd-profile-form-group rd-profile-full-width">
                        <label asp-for="Email" class="form-label">
                            Email Address
                        </label>

                        <input asp-for="Email"
                               class="form-control rd-profile-input" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="rd-profile-form-group rd-profile-full-width">
                        <label asp-for="PhoneNumber" class="form-label">
                            Phone Number
                        </label>

                        <input asp-for="PhoneNumber"
                               class="form-control rd-profile-input" />

                        <span asp-validation-for="PhoneNumber"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <div class="rd-profile-form-actions">
                    <button type="submit" class="btn rd-profile-save-btn">
                        Save Changes
                    </button>

                    <a asp-controller="Participant"
                       asp-action="MyEvents"
                       class="btn rd-profile-cancel-btn">
                        Cancel
                    </a>
                </div>

            </form>

        </section>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
