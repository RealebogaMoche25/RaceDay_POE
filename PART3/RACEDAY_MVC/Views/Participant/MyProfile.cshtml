@model RaceDay.Web.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>My Profile</h2>
        <p class="text-muted">
            View and update your personal account information.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

    <div class="card shadow-sm">
        <div class="card-body p-4">

           <div class="text-center mb-4">

    @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureViewUrl))
    {
        <img src="@Model.ProfilePictureViewUrl"
             alt="Profile picture"
             class="rounded-circle shadow-sm"
             style="width: 150px; height: 150px; object-fit: cover;" />
    }
    else
    {
        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto shadow-sm"
             style="width: 150px; height: 150px;">
            <span class="text-muted">No photo</span>
        </div>
    }

    <form asp-controller="Participant"
          asp-action="UploadProfilePicture"
          method="post"
          enctype="multipart/form-data"
          class="mt-3">

        @Html.AntiForgeryToken()

        <div class="mb-2">
            <input type="file"
                   name="file"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.webp"
                   required />
        </div>

        <button type="submit" class="btn btn-outline-primary">
            Upload Profile Picture
        </button>

        <p class="text-muted small mt-2">
            Accepted formats: JPEG, PNG and WebP. Maximum size: 5 MB.
        </p>

    </form>

</div>

            <form asp-controller="Participant"
                  asp-action="MyProfile"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <input type="hidden" asp-for="UserId" />

                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label">
                        First Name
                    </label>

                    <input asp-for="FirstName" class="form-control" />

                    <span asp-validation-for="FirstName"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="LastName" class="form-label">
                        Last Name
                    </label>

                    <input asp-for="LastName" class="form-control" />

                    <span asp-validation-for="LastName"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">
                        Email Address
                    </label>

                    <input asp-for="Email" class="form-control" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label">
                        Phone Number
                    </label>

                    <input asp-for="PhoneNumber" class="form-control" />

                    <span asp-validation-for="PhoneNumber"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2 mt-4">

                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-controller="Participant"
                       asp-action="MyEvents"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}