
@model List<RaceDay.Web.ViewModels.MyResultViewModel>

@{
    ViewData["Title"] = "My Results";
    var results = Model ?? new List<RaceDay.Web.ViewModels.MyResultViewModel>();
}

<div class="rd-my-results-page">

    <section class="rd-my-results-hero">
        <div>
            <span class="rd-my-results-eyebrow">YOUR RACING PERFORMANCE</span>
            <h1>My Race Results</h1>
            <p>
                Look back at your race performances, track your finishing
                positions and celebrate every milestone.
            </p>
        </div>

        <div class="rd-results-total">
            <strong>@results.Count</strong>
            <span>@(results.Count == 1 ? "Recorded Result" : "Recorded Results")</span>
        </div>
    </section>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <section class="rd-my-results-content">

        <div class="rd-my-results-heading">
            <div>
                <span class="rd-my-results-section-eyebrow">PERFORMANCE HISTORY</span>
                <h2>Your Results</h2>
                <p>Your recorded results, starting with your most recent event.</p>
            </div>

            <a asp-controller="Participant"
               asp-action="MyEvents"
               class="btn rd-results-back-btn">
                My Events
            </a>
        </div>

        @if (results.Any())
        {
            <div class="rd-results-grid">

                @foreach (var result in results.OrderByDescending(r => r.EventDate))
                {
                    <article class="rd-result-card">

                        <div class="rd-result-card-top">
                            <span class="rd-result-event-label">COMPLETED EVENT</span>
                            <span class="rd-result-position-badge">
                                Position #@result.FinishingPosition
                            </span>
                        </div>

                        <div class="rd-result-card-body">

                            <h3>@result.EventName</h3>

                            <div class="rd-result-event-meta">
                                <span>@result.EventDate.ToString("dd MMMM yyyy")</span>
                                <span class="rd-result-meta-divider">|</span>
                                <span>@result.EventLocation</span>
                            </div>

                            <div class="rd-result-time-panel">
                                <span class="rd-result-detail-label">FINISH TIME</span>
                                <strong>@result.FinishTime.ToString(@"hh\:mm\:ss")</strong>
                            </div>

                            <div class="rd-result-information">
                                <div class="rd-result-information-item">
                                    <span class="rd-result-detail-label">CATEGORY</span>
                                    <strong>@result.CategoryName</strong>
                                </div>

                                <div class="rd-result-information-item">
                                    <span class="rd-result-detail-label">FINISHING POSITION</span>
                                    <strong>#@result.FinishingPosition</strong>
                                </div>
                            </div>

                            @if (result.TotalFinishers > 0)
                            {
                                <div class="rd-result-field">
                                    <div class="rd-result-field-heading">
                                        <span>Race field</span>
                                        <strong>@result.FinishingPosition of @result.TotalFinishers</strong>
                                    </div>

                                    <div class="rd-result-field-track">
                                        <div class="rd-result-field-progress"
                                             style="width: @(Math.Clamp((double)result.FinishingPosition / result.TotalFinishers * 100, 0, 100))%">
                                        </div>
                                    </div>

                                    <small>Finishing position out of all recorded finishers</small>
                                </div>
                            }

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="rd-results-empty">
                <div class="rd-results-empty-icon">R</div>
                <h3>No race results available yet</h3>
                <p>
                    Your race results will appear here once an organiser
                    records your finishing time and position.
                    Keep participating and your performance history will grow.
                </p>

                <a asp-controller="Participant"
                   asp-action="MyEvents"
                   class="btn rd-results-back-btn">
                    View My Events
                </a>
            </div>
        }

    </section>

</div>
